{
  "manifest_version": 3,
  "name": "Scribe for Overleaf",
  "version": "0.2.0",
  "description": "Drafts a Related Work section from your project's bibliography and checks whether cited papers actually support the claims made about them.",
  "content_scripts": [
    {
      "matches": ["https://www.overleaf.com/project/*"],
      "js": ["inject.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.overleaf.com/project/*"],
      "js": ["lib/secrets.js", "lib/providers.js", "lib/citations.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://api.semanticscholar.org/*",
    "https://api.crossref.org/*",
    "https://api.openalex.org/*",
    "https://openrouter.ai/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*"
  ],
  "optional_host_permissions": ["<all_urls>"]
}
